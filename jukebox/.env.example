# --- Apple Music (MusicKit) developer credentials ---
# Required for the kiosk's search box. From an Apple Developer account with
# MusicKit enabled: https://developer.apple.com/account/resources/identifiers/list/musicId
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=./secrets/AuthKey.p8

# Storefront (2-letter country code) used for catalog search.
APPLE_MUSIC_STOREFRONT=us

# --- Optional: mirror requests into a real Apple Music playlist ---
# Not required for the kiosk to work. If you set this AND connect once via the
# kiosk's "Connect Apple Music" button, requests are also added to this library
# playlist, and anything added from the Apple Music app to it is picked up too.
# Find the ID with GET /api/apple-music/library-playlists after connecting.
APPLE_MUSIC_PLAYLIST_ID=

# Folder of the DJ's local audio files, scanned to match incoming requests.
LIBRARY_PATH=/path/to/dj/music

# Folder the DJ's software watches/imports playlists from.
HOTFOLDER_PATH=/path/to/dj/watched-playlists
HOTFOLDER_FILENAME=jukebox-queue.m3u8

# How often (seconds) to poll the optional playlist for new tracks.
POLL_INTERVAL_SECONDS=15

PORT=3000

# Where the app persists its queue/state between restarts.
STATE_PATH=./data/state.json

# Set to true to preview the kiosk UI with fake incoming requests,
# without any Apple Music credentials configured.
DEMO_MODE=false
