# --- Apple Music (MusicKit) credentials ---
# From an Apple Developer account with MusicKit enabled:
# https://developer.apple.com/account/resources/identifiers/list/musicId
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=./secrets/AuthKey.p8

# The Apple Music *library* playlist ID that guests add tracks to
# (a playlist with "Collaborate" turned on so anyone with the link can add songs).
# Once APPLE_TEAM_ID/KEY_ID/PRIVATE_KEY are set and the DJ has connected once via
# the kiosk page, call GET /api/apple-music/library-playlists to find this ID.
APPLE_MUSIC_PLAYLIST_ID=

# The share link guests tap/scan to join the playlist in the Apple Music app.
JOIN_URL=

# Folder of the DJ's local audio files, scanned to match incoming requests.
LIBRARY_PATH=/path/to/dj/music

# Folder the DJ's software watches/imports playlists from.
HOTFOLDER_PATH=/path/to/dj/watched-playlists
HOTFOLDER_FILENAME=jukebox-queue.m3u8

# How often (seconds) to poll the playlist for new tracks.
POLL_INTERVAL_SECONDS=15

PORT=3000

# Where the app persists its queue/state between restarts.
STATE_PATH=./data/state.json

# Set to true to preview the kiosk UI with fake incoming requests,
# without any Apple Music credentials configured.
DEMO_MODE=false
